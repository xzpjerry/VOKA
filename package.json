    "check:due": "tsx scripts/check-due-today.ts",
    "check:practice": "tsx scripts/check-practice.ts",
    "check:epub": "tsx scripts/check-epub.ts",
    "data:build": "python3 tools/data/build.py",
    "check:data": "tsx scripts/check-data.ts",
    "check:data:browser": "tsx scripts/check-data-browser.ts",
    "check:contexts": "tsx scripts/check-contexts.ts",
