{
  "name": "voka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts && vite build --config vite.content.config.ts --mode auto",
    "test": "vitest run",
    "check:anki": "tsx scripts/check-anki.ts",
    "check:import": "tsx scripts/check-import.ts",
    "check:level-import": "tsx scripts/check-level-import.ts",
    "cleanup:level-import": "tsx scripts/cleanup-level-import.ts",
    "check:highlight": "tsx scripts/check-highlight.ts",
    "check:manual": "tsx scripts/check-manual.ts",
    "check:dynamic": "tsx scripts/check-dynamic.ts",
    "data:build": "python3 tools/data/build.py",
    "check:data": "tsx scripts/check-data.ts",
    "check:data:browser": "tsx scripts/check-data-browser.ts",
    "check:contexts": "tsx scripts/check-contexts.ts",
    "check:scope": "tsx scripts/check-site-scope.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "happy-dom": "^21.0.4",
    "puppeteer": "^25.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "@types/node": "^26.6.6"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
